# === API ===
# Secreto para firmar los JWT. En produccion es OBLIGATORIO y debe tener >= 24 caracteres.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=change-this-secret
API_PORT=8787
# Ruta del archivo SQLite (opcional). Por defecto server/data/vensur.db
DB_PATH=

# === OAuth backend ===
# Solo se necesita el CLIENT ID (se valida el idToken). No pongas el client secret aqui.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=com.yourcompany.vensur.web

# === Frontend (Vite) ===
VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_APPLE_CLIENT_ID=com.yourcompany.vensur.web
VITE_APPLE_REDIRECT_URI=http://localhost:5174/acceso

# === Seguridad / operacion ===
# Origenes permitidos por CORS, separados por comas. Vacio = abierto (solo dev local).
ALLOWED_ORIGINS=https://tu-dominio.com
# "1"/"true" si la API corre detras de un proxy inverso.
TRUST_PROXY=
# Rate limiting de /api/auth/*
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=40

# === Bots ===
BOTS_ENABLED=false
BOT_USER_COUNT=200
BOTS_TICK_INTERVAL_MS=60000
BOT_CONTROL_TOKEN=
