# === API ===
# Secreto para firmar los JWT. En produccion es OBLIGATORIO y debe tener >= 24 caracteres.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=change-this-secret
# Puerto. En Render/Heroku se usa PORT automaticamente; en local, API_PORT o 8787.
API_PORT=8787
# Ruta del archivo SQLite. Por defecto server/data/vensur.db.
# En produccion con REQUIRE_PERSISTENT_STORAGE=true debe apuntar a un volumen persistente.
DB_PATH=
# Carpeta de subidas. Por defecto server/uploads.
# En produccion con REQUIRE_PERSISTENT_STORAGE=true debe apuntar a un volumen persistente.
UPLOADS_DIR=
# Fuerza que DB_PATH y UPLOADS_DIR sean explicitos y no efimeros (recomendado en produccion).
REQUIRE_PERSISTENT_STORAGE=false
# Pragmas SQLite de robustez.
DB_BUSY_TIMEOUT_MS=5000
DB_SYNCHRONOUS=FULL
# Costo bcrypt para hash de claves (10-14 recomendado).
AUTH_PASSWORD_HASH_ROUNDS=11
# Duracion del access token JWT (ej. 15m, 1h).
AUTH_ACCESS_TOKEN_EXPIRES_IN=15m
# Compatibilidad con configuraciones antiguas. Si defines ambos, manda AUTH_ACCESS_TOKEN_EXPIRES_IN.
AUTH_JWT_EXPIRES_IN=15m
# Vida de las cookies/sesion.
AUTH_ACCESS_COOKIE_MAX_AGE_MS=900000
AUTH_REFRESH_TOKEN_TTL_DAYS=14
AUTH_ACCESS_COOKIE_NAME=vensur_access
AUTH_REFRESH_COOKIE_NAME=vensur_refresh
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
# En produccion recomendado: false (forzar cookie HttpOnly, sin bearer legacy).
AUTH_ALLOW_BEARER_TOKENS=
# En produccion recomendado: false (no devolver token en JSON).
AUTH_EXPOSE_TOKEN_RESPONSE=
# "true" para exponer el codigo de verificacion en la respuesta del registro
# (permite probar sin SMTP). Default: true en dev, false en produccion.
# En produccion solo usar temporalmente para pruebas controladas.
AUTH_EXPOSE_VERIFICATION_CODE=

# === OAuth backend ===
# Solo se necesita el CLIENT ID (se valida el idToken). No pongas el client secret aqui.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=com.yourcompany.vensur.web

# === Frontend (Vite) ===
VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_APPLE_CLIENT_ID=com.yourcompany.vensur.web
VITE_APPLE_REDIRECT_URI=http://localhost:5174/acceso

# === Seguridad / operacion ===
# Origenes permitidos por CORS, separados por comas. Vacio = abierto (solo dev local).
ALLOWED_ORIGINS=https://tu-dominio.com
# En produccion recomendado: true (si falta ALLOWED_ORIGINS, la API no arranca).
REQUIRE_STRICT_CORS=true
# "1"/"true" si la API corre detras de un proxy inverso.
TRUST_PROXY=
# Rate limiting de /api/auth/*
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=40

# Redis opcional para rate limiting distribuido y bloqueo anti brute force
AUTH_REDIS_ENABLED=
AUTH_REDIS_URL=
AUTH_SECURITY_KEY_PREFIX=vensur:auth
AUTH_REDIS_CONNECT_TIMEOUT_MS=1500
AUTH_REDIS_RETRY_BACKOFF_MS=30000

# Bloqueo progresivo de login por IP + identificador
AUTH_LOGIN_FAIL_WINDOW_MS=1800000
AUTH_LOGIN_LOCK_L1_AFTER=5
AUTH_LOGIN_LOCK_L1_MS=120000
AUTH_LOGIN_LOCK_L2_AFTER=8
AUTH_LOGIN_LOCK_L2_MS=600000
AUTH_LOGIN_LOCK_L3_AFTER=12
AUTH_LOGIN_LOCK_L3_MS=1800000

# Retencion de eventos de auditoria de seguridad (dias)
SECURITY_EVENT_RETENTION_DAYS=30

# MFA TOTP (2FA)
# Clave de cifrado para secretos TOTP (obligatoria en produccion).
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_MFA_SECRET_ENCRYPTION_KEY=
# Tiempo de vida del token temporal de setup MFA.
AUTH_MFA_SETUP_TOKEN_EXPIRES_IN=10m
# TTL del desafio MFA al iniciar sesion.
AUTH_MFA_LOGIN_CHALLENGE_TTL_MS=300000
# Intentos maximos permitidos por desafio MFA.
AUTH_MFA_LOGIN_MAX_ATTEMPTS=6
# Nombre mostrado en la app autenticadora.
AUTH_MFA_TOTP_ISSUER=VensuR

# Usuarios permitidos para leer /api/security/audit-events.
# Formato: lista separada por comas de username, email o user id.
SECURITY_AUDIT_ADMIN_ALLOWLIST=

# === Correo (verificacion de cuenta) ===
# console (default) | file | smtp
MAIL_TRANSPORT=console
MAIL_FROM=VensuR <no-reply@tudominio.com>
# transporte "file": carpeta donde se escriben los correos (por defecto server/outbox)
MAIL_OUTBOX_DIR=
# transporte "smtp" (requiere: npm i nodemailer)
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# === Bots ===
BOTS_ENABLED=false
BOT_USER_COUNT=200
BOTS_TICK_INTERVAL_MS=60000
BOT_CONTROL_TOKEN=
